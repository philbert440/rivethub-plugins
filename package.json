{
  "name": "rivethub-workflows",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test && npm run contract:check && npm run privacy",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "node --test 'tests/**/*.test.ts'",
    "contract": "node scripts/contract.ts",
    "contract:check": "node scripts/contract.ts --check",
    "privacy": "node scripts/privacy.ts --tracked"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  }
}
